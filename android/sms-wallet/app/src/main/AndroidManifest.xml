<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ThemeActivity: applies the virtual Seeker wallpaper -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- Normal (non-privileged) wallet access to Seed Vault, like third-party wallets on Seeker -->
    <uses-permission android:name="com.solanamobile.seedvault.ACCESS_SEED_VAULT" />

    <queries>
        <package android:name="com.solanamobile.seedvaultimpl" />
        <package android:name="com.solanamobile.seedvault" />
        <!-- dApps screen: list the launchable apps the developer installed -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="SMS Test Wallet"
        android:icon="@mipmap/ic_wallet"
        android:roundIcon="@mipmap/ic_wallet"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">

        <!-- Status screen: connect Seed Vault, pick the approval policy -->
        <!-- "Wallet" on the home screen, where a real Seeker has its Seed Vault Wallet -->
        <activity
            android:name=".MainActivity"
            android:label="Wallet"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- "dApps": sits where the dApp Store is on a real Seeker; lists your installed apps -->
        <activity
            android:name=".DappsActivity"
            android:label="dApps"
            android:icon="@mipmap/ic_dapps"
            android:roundIcon="@mipmap/ic_dapps"
            android:taskAffinity="dev.sms.wallet.dapps"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Applies the Seeker-style wallpaper; started by `sms setup` -->
        <activity
            android:name=".ThemeActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Mobile Wallet Adapter entry point (same filters as the official fakewallet) -->
        <activity
            android:name=".MwaActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="dev.sms.wallet.mwa_host_task"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
            <intent-filter android:order="1">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="solana-wallet" />
            </intent-filter>
            <intent-filter android:order="0">
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="solana-wallet" />
            </intent-filter>
        </activity>
    </application>
</manifest>
